<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.dobby.quickcopy</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dobby-copy</string>
			</array>
		</dict>
	</array>
	<key>Cafe24AppAPIKey</key>
	<string>$(DOBBY_APP_API_KEY)</string>
	<key>Cafe24BackendBaseURL</key>
	<string>$(CAFE24_BACKEND_BASE_URL)</string>
	<key>InstagramAppAPIKey</key>
	<string>$(DOBBY_INSTAGRAM_APP_API_KEY)</string>
	<key>InstagramBackendBaseURL</key>
	<string>$(INSTAGRAM_BACKEND_BASE_URL)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NaverBackendBaseURL</key>
	<string>$(NAVER_BACKEND_BASE_URL)</string>
	<key>UIAppFonts</key>
	<array>
		<string>Pretendard-Regular.otf</string>
	</array>
</dict>
</plist>
