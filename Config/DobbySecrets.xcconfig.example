// Copy this file to DobbySecrets.xcconfig and fill in local values.
// DobbySecrets.xcconfig is excluded from Git.
CAFE24_BACKEND_BASE_URL = https:/$()/YOUR-WORKER.YOUR-SUBDOMAIN.workers.dev
INSTAGRAM_BACKEND_BASE_URL = https:/$()/YOUR-INSTAGRAM-WORKER.YOUR-SUBDOMAIN.workers.dev
DOBBY_INSTAGRAM_APP_API_KEY = YOUR_INSTAGRAM_WORKER_APP_KEY
INSTAGRAM_DEV_BACKEND_BASE_URL = https:/$()/dobby-instagram-dev.YOUR-SUBDOMAIN.workers.dev
DOBBY_INSTAGRAM_DEV_APP_API_KEY = YOUR_INSTAGRAM_DEV_WORKER_APP_KEY
DOBBY_APP_API_KEY = GENERATE_A_RANDOM_64_CHARACTER_HEX_VALUE
